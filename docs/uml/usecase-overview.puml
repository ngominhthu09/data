@startuml
' Unira – UML Use Case: multiple independent processing sessions
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam usecaseBorderColor #3555a0
skinparam usecaseBackgroundColor #f6faff
skinparam actorBorderColor #334155

actor "Steward" as S
actor "Viewer" as V
S --|> V : kế thừa quyền xem

rectangle "Unira" {
  (UC01 – Quản lý phiên xử lý) as UC01
  (UC02 – Tải file vào phiên) as UC02
  (UC03 – Chạy AI cho phiên) as UC03
  (UC04 – Xem nhóm nghi trùng) as UC04
  (UC05 – Phê duyệt / từ chối gộp) as UC05
  (UC06 – Tra cứu hồ sơ theo phiên) as UC06
  (UC07 – Tách hồ sơ gộp nhầm) as UC07
  (UC08 – Xem thống kê theo phiên) as UC08
  (UC09 – Xem chất lượng dữ liệu) as UC09
  (UC10 – Tải CSV sạch của phiên) as UC10
}
S -- UC01
S -- UC02
S -- UC03
S -- UC04
S -- UC05
S -- UC07
S -- UC09
S -- UC10
V -- UC06
V -- UC08
@enduml
