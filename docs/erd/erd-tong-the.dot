digraph "erd-tong-the" {
	graph [bgcolor=white dpi=144 fontcolor="#0f172a" fontname=Arial fontsize=19 label="UNIRA  |  ERD tổng hợp – 12 bảng, 19 quan hệ khóa ngoại" labeljust=l labelloc=t nodesep=.42 outputorder=edgesfirst pad=.32 rankdir=LR ranksep=1.45 splines=spline]
	node [fontname=Arial fontsize=10 shape=plain]
