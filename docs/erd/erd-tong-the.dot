	import_batches -> source_records [arrowhead=crowodot arrowtail=tee headport="import_batch_id:w"]
	match_jobs -> match_candidates [arrowhead=crowodot arrowtail=tee headport="job_id:w"]
	match_jobs -> match_groups [arrowhead=crowodot arrowtail=tee headport="job_id:w"]
	match_jobs -> clean_exports [arrowhead=crowodot arrowtail=teeodot headport="job_id:w"]
	source_records -> match_candidates [arrowhead=crowodot arrowtail=tee constraint=true headport="record_a_id:w"]
	source_records -> match_candidates [arrowhead=crowodot arrowtail=tee constraint=false headport="record_b_id:w"]
	source_records -> group_members [arrowhead=crowodot arrowtail=tee headport="record_id:w"]
	source_records -> master_links [arrowhead=crowodot arrowtail=tee headport="record_id:w"]
	match_groups -> group_members [arrowhead=crowodot arrowtail=tee headport="group_id:w"]
	match_groups -> review_decisions [arrowhead=crowodot arrowtail=tee headport="group_id:w"]
	review_decisions -> master_links [arrowhead=crowodot arrowtail=teeodot headport="review_decision_id:w"]
	master_records -> master_links [arrowhead=crowodot arrowtail=tee headport="master_id:w"]
}
